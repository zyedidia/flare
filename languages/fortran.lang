ws <- space+

# free form comments; fixed form 'c' comments are only valid in column one
comment <- cap{'!' (!'
' .)*, "comment"}

string <- cap{"'" ("''" / (!['
] .))* "'"? / '"' ('""' / (!["
] .))* '"'?, "constant.string"}

number <- cap{float ('_' word)? / integer ('_' word)? / integer [eEdD] [+\-]? integer, "constant.number"} !(alnum / '_')

# .and. .not. .true. and friends
dotted <- cap{'.' words{
    'and', 'or', 'not', 'eqv', 'neqv', 'eq', 'ne', 'gt', 'ge', 'lt', 'le',
