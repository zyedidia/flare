ws <- space+

line_comment  <- '//' (!'\n' .)*
block_comment <- '/*' {{(!'*/' .)}}* '*/'?
comment       <- cap{line_comment / block_comment, "comment"}

# strings, including the s"..." style interpolators and triple quotes
escape        <- cap{'\\' (['"tnbfr\\] / 'u' xdigit xdigit xdigit xdigit), "constant.string.escape"}
interp        <- word &'"'
triple_str    <- '"""' {{(!'"""' .)}}* '"""'?
dq_str        <- '"' (escape / (!["\n] .))* '"'?
string        <- cap{interp? (triple_str / dq_str), "constant.string"}
char          <- cap{"'" (escape / (!['\n] .)) "'", "constant.string.char"}
symbol        <- cap{"'" word, "constant"}

number        <- cap{(float / integer) [LlFfDd]?, "constant.number"}

keyword <- cap{
    words{
        "abstract", "case", "catch", "class", "def", "derives", "do", "else",
        "end", "enum", "export", "extends", "extension", "final", "finally",
        "for", "forSome", "given", "if", "implicit", "import", "inline", "lazy",
        "match", "new", "object", "opaque", "override", "package", "private",
        "protected", "return", "sealed", "super", "then", "this", "throw",
        "trait", "transparent", "try", "type", "using", "val", "var", "while",
        "with", "yield"
    },
    "keyword"
}

bool <- cap{
    words{"true", "false", "null"},
    "constant.bool"
}

builtin <- cap{
    words{
        "assert", "assume", "implicitly", "print", "printf", "println",
        "readBoolean", "readByte", "readChar", "readDouble", "readFloat",
        "readInt", "readLine", "readLong", "readShort", "readf", "require"
    },
    "function.builtin"
}

# any capitalized name is a type, object or case class constructor
type       <- cap{[A-Z] (alnum / '_')*, "type"}
annotation <- cap{'@' word, "type.annotation"}
identifier <- cap{word, "identifier"}
operator   <- cap{[+\-*/%<>!=^&|?~:;.,@#()\[\]{}], "symbol.operator"}

# definitions, with the name being defined
def   <- cap{'def', "keyword"} space+ cap{word, "function"}
class <- cap{'class' / 'trait' / 'object' / 'enum', "keyword"} space+ cap{word, "type.class"}
func  <- cap{word, "function"} '('

token <- ws
       / comment
       / string
       / char
       / symbol
       / def
       / class
       / keyword
       / bool
       / builtin
       / type
       / func
       / identifier
       / number
       / annotation
       / operator
