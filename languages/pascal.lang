ws <- space+

block_comment <- '{' (!'}' .)* '}'? / '(*' {{(!'*)' .)}}* '*)'?
line_comment  <- '//' (!'
' .)*
comment       <- cap{line_comment / block_comment, "comment"}

directive <- cap{('{$' / '(*$') (!('}' / '*)') .)* ('}' / '*)')?, "preproc"}

string <- cap{"'" ("''" / (!['
] .))* "'"? / '#' digit+, "constant.string"}

number <- cap{'$' xdigit+ / float / integer, "constant.number"} !(alnum / '_')

