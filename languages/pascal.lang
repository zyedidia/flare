}, "type"}

builtin <- cap{words{
    'chr', 'ord', 'succ', 'pred', 'abs', 'round', 'trunc', 'sqr', 'sqrt',
    'arctan', 'cos', 'sin', 'exp', 'ln', 'odd', 'eof', 'eoln', 'CHR', 'ORD',
