    'SIN', 'EXP', 'LN', 'ODD', 'EOF', 'EOLN'
}, "function.builtin"}

bool <- cap{words{'true', 'false', 'nil', 'True', 'False', 'Nil', 'TRUE', 'FALSE', 'NIL'}, "constant.bool"}

define <- cap{words{'procedure', 'function', 'program', 'unit', 'PROCEDURE', 'FUNCTION', 'PROGRAM', 'UNIT'}, "keyword"}
          space+ cap{word ('.' word)*, "function"}

identifier <- cap{word, "identifier"}
operator   <- cap{[+\-*/<>=@^.,:;()\[\]], "symbol.operator"}

token <- ws
       / directive
       / comment
       / string
       / define
       / bool
       / keyword
       / type
       / builtin
       / identifier
       / number
       / operator
