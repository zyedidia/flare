type <- cap{words{
    'shortint', 'byte', 'char', 'smallint', 'integer', 'word', 'longint',
    'cardinal', 'boolean', 'bytebool', 'wordbool', 'longbool', 'real', 'single',
    'double', 'extended', 'comp', 'currency', 'pointer', 'SHORTINT', 'BYTE',
    'CHAR', 'SMALLINT', 'INTEGER', 'WORD', 'LONGINT', 'CARDINAL', 'BOOLEAN',
    'BYTEBOOL', 'WORDBOOL', 'LONGBOOL', 'REAL', 'SINGLE', 'DOUBLE', 'EXTENDED',
