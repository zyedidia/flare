# autogenerated

ws <- space+

line_comment  <- '//' (!'\n' .)*
block_comment <- '/*' (!'*/' .)* '*/'?
comment       <- cap{line_comment / block_comment, "comment"}

sq_str        <- "'" (escape / (!"'" .))* "'"?
dq_str        <- '"' (escape / (!'"' .))* '"'?
escape        <- cap{'\\' ['"tnbfr\\'], "constant.string.escape"}
string        <- cap{sq_str / dq_str, "constant.string"}

number        <- cap{(float / integer), "constant.number"}

keywords <- cap{
    words{
        'class', 'deinit', 'enum', 'extension', 'func', 'import', 'init', 'inout', 'let', 'operator',
        'protocol', 'static', 'struct', 'subscript', 'typealias', 'var', 'break', 'case', 'continue',
        'default', 'defer', 'do', 'else', 'fallthrough', 'for', 'guard', 'if', 'in', 'repeat', 'return',
        'switch', 'where', 'while', 'as', 'Any', 'catch', 'false', 'is', 'nil', 'rethrows', 'super', 'self',
        'Self', 'throw', 'throws', 'true', 'try'
    }, 
    "keyword"
}

identifier <- cap{word, "identifier"}

operator <- cap{
    [+\-/*%<>~!=^&|?~:;,.()\[\]{}@#] / words{'->', '...'},
    "symbol.operator"
}

token <- ws
       / comment
       / keywords
       / identifier
       / string
       / number
       / operator

