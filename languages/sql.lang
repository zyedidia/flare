ws <- space+

line_comment  <- ('--' / '#') (!'
' .)*
block_comment <- '/*' {{(!'*/' .)}}* '*/'?
comment       <- cap{line_comment / block_comment, "comment"}

# a doubled quote is how a quote is escaped inside a string
sq_str <- "'" ("''" / (!"'" .))* "'"?
dq_str <- '"' ('""' / (!'"' .))* '"'?
bq_str <- "`" (!"`" .)* "`"?
string <- cap{sq_str / dq_str, "constant.string"}
quoted <- cap{bq_str, "identifier"}

number <- cap{float / integer, "constant.number"} !(alnum / '_')

