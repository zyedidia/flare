# autogenerated

ws <- space+

line_comment  <- '--' (!'\n' .)*
block_comment <- '{-' (!'-}' .)* '-}'?
comment       <- cap{line_comment / block_comment, "comment"}

sq_str        <- "'" (escape / (!"'" .))* "'"?
dq_str        <- '"' (escape / (!'"' .))* '"'?
escape        <- cap{'\\' ['"tnbfr\\], "constant.string.escape"}
string        <- cap{sq_str / dq_str, "constant.string"}

number        <- cap{(float / integer), "constant.number"}

keywords <- cap{
    words{
        'if', 'then', 'else', 'case', 'of', 'let', 'in',
        'type', 'alias', 'module', 'where', 'import', 'exposing',
        'port', 'as', 'infix', 'infixl', 'infixr'
    }, 
    "keyword"
}

identifier <- cap{word, "identifier"}

operator <- cap{
    [+\-/*%<>~!=^&|?~:;,.()\[\]{}] / words{'->', '|', '::', '==', '/=', '<=', '>=', '&&', '||', '<-', '--', '++'},
    "symbol.operator"
}

token <- ws
       / comment
       / keywords
       / identifier
       / string
       / number
       / operator

