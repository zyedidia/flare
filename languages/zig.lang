# autogenerated

ws <- space+

line_comment  <- '//' (!'\n' .)*
block_comment <- '/*' (!'*/' .)* '*/'?
comment       <- cap{line_comment / block_comment, "comment"}

sq_str        <- "'" (escape / (!"'" .))* "'"?
dq_str        <- '"' (escape / (!'"' .))* '"'?
escape        <- cap{'\\' ['"tnbfr\\'], "constant.string.escape"}
string        <- cap{sq_str / dq_str, "constant.string"}

number        <- cap{(float / integer ['LUlu']*), "constant.number"}

keywords <- cap{
    words{
        'const', 'var', 'extern', 'packed', 'export', 'pub', 'noalias', 'inline', 'comptime',
        'nakedcc', 'stdcallcc', 'volatile', 'allowzero', 'align', 'linksection', 'threadlocal',
        'fn', 'usingnamespace', 'break', 'return', 'continue', 'asm', 'defer', 'errdefer',
        'unreachable', 'suspend', 'struct', 'enum', 'union', 'error', 'undefined', 'anyframe',
        'if', 'else', 'switch', 'and', 'or', 'orelse', 'while', 'for', 'try', 'catch',
        'async', 'await', 'cancel', 'resume'
    }, 
    "keyword"
}

identifier <- cap{word, "identifier"}

operator <- cap{
    [+\-/*%<>~!=^&|?~:;,.()\[\]{}] / words{'->', '::', '??', '.*'},
    "symbol.operator"
}

token <- ws
       / comment
       / keywords
       / identifier
       / string
       / number
       / operator

