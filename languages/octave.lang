ws <- space+

block_comment <- ('%{' / '#{') (!('%}' / '#}') .)* ('%}' / '#}')?
line_comment  <- [%#] (!'\n' .)*
comment       <- cap{block_comment / line_comment, "comment"}

escape <- cap{'\\' ['"\\nrtfav0], "constant.string.escape"}
sq_str <- "'" ("''" / (!['\n] .))* "'"?
dq_str <- '"' (escape / (!["\n] .))* '"'?
string <- cap{dq_str / sq_str, "constant.string"}

number <- cap{(float / hex_num / integer) [ij]?, "constant.number"} !(alnum / '_')

keyword <- cap{words{
    'break', 'case', 'catch', 'classdef', 'continue', 'do', 'else', 'elseif',
    'end', 'end_try_catch', 'end_unwind_protect', 'endclassdef', 'endenumeration',
    'endevents', 'endfor', 'endfunction', 'endif', 'endmethods', 'endparfor',
    'endproperties', 'endswitch', 'endwhile', 'enumeration', 'events', 'for',
    'function', 'global', 'if', 'methods', 'otherwise', 'parfor', 'persistent',
    'properties', 'return', 'switch', 'try', 'until', 'unwind_protect',
    'unwind_protect_cleanup', 'while'
}, "keyword"}

builtin <- cap{words{
    'abs', 'all', 'any', 'ceil', 'cell', 'cellfun', 'char', 'class', 'cos',
    'cumsum', 'diag', 'diff', 'disp', 'display', 'double', 'error', 'exp',
    'eye', 'false', 'fclose', 'feval', 'fieldnames', 'find', 'fix', 'floor',
    'fopen', 'fprintf', 'isempty', 'isfield', 'ismember', 'isnumeric', 'length',
    'linspace', 'load', 'log', 'logical', 'max', 'mean', 'min', 'mod', 'nan',
    'numel', 'ones', 'plot', 'printf', 'prod', 'rand', 'randn', 'repmat',
    'reshape', 'round', 'save', 'sign', 'sin', 'single', 'size', 'sort',
    'sprintf', 'sqrt', 'std', 'strcmp', 'strrep', 'strsplit', 'struct', 'sum',
    'tan', 'true', 'zeros'
}, "function.builtin"}

bool <- cap{words{'true', 'false', 'pi', 'e', 'Inf', 'NaN', 'NA', 'eps'}, "constant.bool"}

func <- cap{'function', "keyword"} space+ (cap{(!('(' / '\n' / '=') .)+ '=', "identifier"})? [ \t]* cap{word, "function"}

identifier <- cap{word, "identifier"}
operator   <- cap{[+\-*/\\^<>=~!&|:;,.'()\[\]{}@], "symbol.operator"}

token <- ws
       / comment
       / string
       / func
       / bool
       / keyword
       / builtin
       / identifier
       / number
       / operator
